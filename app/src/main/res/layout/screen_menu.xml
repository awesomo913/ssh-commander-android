<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:minHeight="480dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvMenuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_main"
            android:textColor="@color/green"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvMenuSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_main"
            android:textColor="@color/fg2"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <!-- Command count stat -->
        <TextView
            android:id="@+id/tvCommandCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="55 commands loaded"
            android:textColor="@color/blue"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="48dp" />

        <!-- LEARN button -->
        <Button
            android:id="@+id/btnLearn"
            style="@style/Widget.SshCommander.Button.Learn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_learn"
            android:layout_marginBottom="16dp" />

        <!-- CHALLENGE button -->
        <Button
            android:id="@+id/btnChallenge"
            style="@style/Widget.SshCommander.Button.Challenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_challenge"
            android:layout_marginBottom="16dp" />

        <!-- BOSS MODE button -->
        <Button
            android:id="@+id/btnBoss"
            style="@style/Widget.SshCommander.Button.Boss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_boss"
            android:layout_marginBottom="0dp" />

    </LinearLayout>
</ScrollView>
